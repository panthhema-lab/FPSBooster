<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/backgroundDark"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/textWhite"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textRamStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ram_status_placeholder"
        android:textColor="@color/textGray"
        android:textSize="15sp" />

    <ProgressBar
        android:id="@+id/progressRam"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="40"
        android:progressTint="@color/accentGreen" />

    <Button
        android:id="@+id/buttonBoost"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/accentGreen"
        android:text="@string/boost_now"
        android:textColor="@color/textWhite"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/game_mode_label"
            android:textColor="@color/textWhite"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/switchGameMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/shortcuts_title"
        android:textColor="@color/textWhite"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/shortcuts_subtitle"
        android:textColor="@color/textGray"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@color/cardDark"
        android:orientation="vertical"
        android:padding="4dp">

        <Button
            android:id="@+id/buttonShortcutDisplay"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="2dp"
            android:background="@color/cardDark"
            android:gravity="start|center_vertical"
            android:paddingStart="12dp"
            android:text="@string/shortcut_display"
            android:textAllCaps="false"
            android:textColor="@color/accentBlue"
            android:textSize="15sp" />

        <Button
            android:id="@+id/buttonShortcutBattery"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="2dp"
            android:background="@color/cardDark"
            android:gravity="start|center_vertical"
            android:paddingStart="12dp"
            android:text="@string/shortcut_battery"
            android:textAllCaps="false"
            android:textColor="@color/accentBlue"
            android:textSize="15sp" />

        <Button
            android:id="@+id/buttonShortcutDeveloper"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/cardDark"
            android:gravity="start|center_vertical"
            android:paddingStart="12dp"
            android:text="@string/shortcut_developer"
            android:textAllCaps="false"
            android:textColor="@color/accentBlue"
            android:textSize="15sp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/apps_list_title"
        android:textColor="@color/textWhite"
        android:textSize="16sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />

</LinearLayout>
